{
  "name": "schemesaathi-unified-bot",
  "version": "3.0.0",
  "description": "SchemeSaathi - Unified AI-powered bot for Telegram & WhatsApp with automatic message sync",
  "main": "unified-bot.js",
  "scripts": {
    "start": "node --max-old-space-size=2048 --expose-gc unified-bot.js",
    "dev": "node --max-old-space-size=2048 --expose-gc --watch unified-bot.js",
    "telegram-only": "node --max-old-space-size=1024 --expose-gc bot.js"
  },
